# Shared environment variables for all compose files
# Copy to .env and fill in values before starting

# Network (must match existing cht-docker setup)
CHT_NETWORK=cht-net

# CouchDB credentials (must match ~/cht-docker/.env)
COUCHDB_USER=admin
COUCHDB_PASSWORD=secret

# PostgreSQL (Phase 2)
POSTGRES_USER=cht
POSTGRES_PASSWORD=pgpass

# PowerSync (Phase 3)
POWERSYNC_ADMIN_TOKEN=changeme

# CHT image version (set by npm run local-images)
VERSION=5.1.0

# Host paths (adjust if your layout differs)
CHT_CORE_PATH=/home/h4reet/ai_medic/cht-core
CHT_AI_TOOLS_PATH=/home/h4reet/ai_medic/cht-ai-tools

# Claude Code auth (log in once on host: claude login)
# Path to your ~/.claude directory containing .credentials.json
CLAUDE_CONFIG_PATH=/home/h4reet/.claude

# Agent resource limits
AGENT_MEMORY_LIMIT=4G
AGENT_CPU_LIMIT=2
