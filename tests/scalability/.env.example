# Scalability benchmark environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# CouchDB admin URL (through CHT API proxy)
COUCH_URL=http://admin:YOUR_ADMIN_PASSWORD@localhost:5988/medic

# CHT API URL
API_URL=http://localhost:5988

# PostgreSQL
POSTGRES_PASSWORD=YOUR_PG_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cht
POSTGRES_DB=cht

# Test user credentials (used by shell scripts for user arrays)
TEST_USER_PASS=YOUR_TEST_USER_PASSWORD

# PowerSync
POWERSYNC_URL=http://localhost:8080

# CouchDB admin credentials (for health checks in shell scripts)
COUCH_ADMIN_USER=admin
COUCH_ADMIN_PASS=YOUR_ADMIN_PASSWORD
